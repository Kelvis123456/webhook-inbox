# Postgres local: docker compose up -d db
DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres
# El secreto de firma del endpoint de webhooks (en Stripe: Developers > Webhooks > Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_cambia_esto
# Opcional. Sin él el panel /admin/events no existe.
ADMIN_TOKEN=
# Opcional. Cada cuántos ms corre el worker (0 lo apaga). Por defecto 1000.
WORKER_INTERVAL_MS=1000
